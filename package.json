{
  "name": "novelty",
  "version": "1.0.0",
  "description": "A premium markdown studio for chapters, notes, and everything in between.",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/marwan343343chif-debug/Novelty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marwan343343chif-debug/Novelty.git"
  },
  "bugs": {
    "url": "https://github.com/marwan343343chif-debug/Novelty/issues"
  },
  "author": {
    "name": "Marwan Mrabti"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.3",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.2.4",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.2",
    "lucide-react": "^0.487.0",
    "marked": "^15.0.7",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.14",
    "vitest": "^3.2.7",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
